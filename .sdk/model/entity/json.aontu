  id: {
    field: "id"
    name: "id"
  }

  name: "json"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /json/{query}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: "8.8.8.8"
                k: "param"
                n: "id"
                or: "query"
                r: true
                t: "`$STRING`"
              }
            ]
            query: [
              {
                k: "query"
                n: "callback"
                or: "callback"
                r: false
                t: "`$STRING`"
              }
              {
                ex: "status,message,country,city,lat,lon"
                k: "query"
                n: "field"
                or: "field"
                r: false
                t: "`$STRING`"
              }
              {
                ex: "en"
                k: "query"
                n: "lang"
                or: "lang"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/json/{query}"
          q: {
            exist: [
              "callback"
              "field"
              "id"
              "lang"
            ]
          }
          r: {
            param: {
              query: "id"
            }
          }
          s: [
            {
              lit: "json"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          co: {
            id: "GET /json/"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "callback"
                or: "callback"
                r: false
                t: "`$STRING`"
              }
              {
                ex: "status,message,country,city,lat,lon"
                k: "query"
                n: "field"
                or: "field"
                r: false
                t: "`$STRING`"
              }
              {
                ex: "en"
                k: "query"
                n: "lang"
                or: "lang"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/json/"
          q: {
            exist: [
              "callback"
              "field"
              "lang"
            ]
          }
          s: [
            {
              lit: "json"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



